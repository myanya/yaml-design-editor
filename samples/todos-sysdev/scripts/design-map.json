          "d-doc"
        ]
      },
      {
        "id": "p-in",
        "layer": "prog",
        "row": 0,
        "col": 0,
        "kind": "input",
        "label": [
          "方式の入力"
        ],
        "members": [
          "in:design/detail/inputs/application/*.yaml",
          "in:design/detail/inputs/appearance/*.yaml"
        ]
      },
      {
        "id": "p-info",
        "layer": "prog",
        "row": 0,
        "col": 2,
        "kind": "main",
        "label": [
          "プログラム設計の情報",
          "（application-* ほか）"
        ],
        "members": [
          "t:application-java-types",
          "t:application-configuration",
          "t:application-theme",
          "t:application-data-model",
          "t:application-access",
          "t:application-runtime-model",
          "t:application-service-inputs",
          "t:application-service-bindings",
          "t:application-service-programs",
          "t:application-web-forms",
          "t:application-web-bindings",
          "t:application-web",
          "t:application-output-plan"
        ]
