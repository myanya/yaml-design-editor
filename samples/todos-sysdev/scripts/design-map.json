{
  "comment": "設計書の依存マップ（scripts/design-map.py）の設定。線は変換定義から計算するので、ここに書くのは箱の並べ方と、どの変換定義がどの箱を作るかだけ。",
  "title": "todos-sysdev 設計書の依存関係",
  "select": "proc",
  "columns": [
    { "id": "bm", "label": "業務モデル", "sub": ".yde/schemas・views/business/" },
    { "id": "basic", "label": "基本設計", "sub": "design/basic/final/" },
    { "id": "detail", "label": "詳細設計", "sub": "design/detail/final/" },
    { "id": "prog", "label": "プログラム設計", "sub": "…/final/application-*.yaml" }
  ],
  "matrixColumns": ["basic", "detail"],
  "lanes": [
    { "id": "data", "label": ["データ"] },
    { "id": "op", "label": ["操作"] },
    { "id": "screen", "label": ["画面"] },
    { "id": "msg", "label": ["エラー・", "メッセージ"] },
    { "id": "domain", "label": ["ドメイン"] },
    { "id": "arch", "label": ["方式"] }
  ],
  "modelParts": {
    "entities": "ent", "relations": "ent", "types": "ent", "schemas": "ent",
    "actions": "act",
    "lifecycles": "bmO", "states": "bmO", "constraints": "bmO",
    "dashboards": "bmV", "views": "bmV", "reach": "bmV"
  },
  "models": [
    { "transform": "system-model", "id": "SYS-model", "parts": { "actions": "bmO" } },
    { "transform": "system-actions-model", "id": "SYS-system-actions-model" },
    { "transform": "system-screen-input-model", "id": "SYS-system-screen-input-model", "carries": ["scrO"] }
  ],
  "renames": [
    { "transform": "system-screen-bindings", "id": "SYS-system-screen-bindings", "label": "画面の URL" },
    { "transform": "system-access-bindings", "id": "SYS-system-access-bindings", "label": "Mapper の呼び名" },
    { "transform": "system-process-bindings", "id": "SYS-system-process-bindings", "label": "Service の呼び名" },
    { "transform": "system-session-bindings", "id": "SYS-system-session-bindings", "label": "セッションのキー" }
  ],
  "inputs": ["INPUT-*", "COR-*", "SPC-*", "ADD-*", "SADD-*", "SCOR-*", "SSPC-*", "DCOR-*"],
  "ignore": [
    "basic-document-input-gate", "detail-document-input-gate", "application-form-gate", "application-process-gate",
    "system-final", "application-output-plan"
  ],
  "nodes": [
    { "id": "bmS", "name": "項目と型", "column": "bm", "lane": "data", "place": ".yde/schemas/business/（common・todo-list・todo-detail ほか）" },
    { "id": "bmO", "name": "操作・状態・決まり", "column": "bm", "lane": "op", "place": ".yde/schemas/business/operations.yaml・todo-behavior.yaml ほか" },
    { "id": "bmV", "name": "ダッシュボードとビュー", "column": "bm", "lane": "screen", "place": ".yde/views/business/" },

    { "id": "ent", "name": "エンティティ定義書", "column": "basic", "lane": "data",
      "transforms": ["basic-derived", "basic-targets", "basic-type-changes", "basic-type-model", "basic-field-uses", "basic-descriptions",
        "basic-field-changes", "basic-field-model", "basic-entity-candidates", "basic-type-candidates", "basic-final",
        "basic-classes", "basic-types", "basic-entities"],
      "ids": ["ENT-*", "TYP-*", "FLD-*", "CLS-*", "CMP-*", "DRV-business", "DRV-targets"],
      "reads": { "c": ["bmS", "bmO"] },
      "input": "design/basic/inputs/entities/" },
    { "id": "act", "name": "アクション定義書", "column": "basic", "lane": "op", "kind": "action-specs" },
    { "id": "scrL", "name": "画面定義書（一覧）", "column": "basic", "lane": "screen", "kind": "screen-lists" },
    { "id": "scrD", "name": "画面定義書（詳細）", "column": "basic", "lane": "screen", "kind": "screen-details" },
    { "id": "scrO", "name": "画面定義書（操作）", "column": "basic", "lane": "screen", "kind": "screen-operations",
      "transforms": ["screen-operation-candidates"], "ids": ["CAN-screen-operation.*"] },
    { "id": "trans", "name": "画面遷移定義書", "column": "basic", "lane": "screen", "kind": "screen-transitions" },
    { "id": "msg", "name": "メッセージ定義書", "column": "basic", "lane": "msg", "kind": "messages" },
    { "id": "err", "name": "エラー定義書", "column": "basic", "lane": "msg", "kind": "errors" },
    { "id": "dom", "name": "ドメイン定義書", "column": "basic", "lane": "domain", "kind": "domains" },
    { "id": "domrel", "name": "ドメイン関連定義書", "column": "basic", "lane": "domain", "kind": "domain-relations" },

    { "id": "tbl", "name": "テーブル設計書", "column": "detail", "lane": "data",
      "transforms": ["detail-tables-derived", "detail-tables"],
      "ids": ["TBL-*", "COL-*", "IDX-*", "FK-*", "SQL-*", "SYS-physical-derived", "SYS-physical-final"],
      "input": "design/detail/inputs/tables/" },
    { "id": "tacc", "name": "テーブルアクセス設計書", "column": "detail", "lane": "data", "kind": "table-access" },
    { "id": "status", "name": "状態の判定", "column": "detail", "lane": "op", "kind": "status-rules" },
    { "id": "proc", "name": "処理設計書", "column": "detail", "lane": "op", "kind": "processes" },
    { "id": "sdL", "name": "画面設計書（一覧）", "column": "detail", "lane": "screen", "kind": "screen-designs-lists" },
    { "id": "sdD", "name": "画面設計書（詳細）", "column": "detail", "lane": "screen", "kind": "screen-designs-details" },
    { "id": "sdO", "name": "画面設計書（操作）", "column": "detail", "lane": "screen", "kind": "screen-designs-operations" },
    { "id": "flow", "name": "画面遷移設計", "column": "detail", "lane": "screen", "kind": "screen-flows" },
    { "id": "dflow", "name": "画面遷移設計（一覧）", "column": "detail", "lane": "screen", "kind": "dashboard-flows" },
    { "id": "sess", "name": "セッション情報設計", "column": "detail", "lane": "screen", "kind": "session-design" },
    { "id": "style", "name": "画面のクラスの対応表", "column": "detail", "lane": "screen", "kind": "screen-styles",
      "input": "design/detail/inputs/documents/additions.yaml" },
    { "id": "errh", "name": "エラー設計書", "column": "detail", "lane": "msg", "kind": "error-handling" },

    { "id": "dmodel", "name": "行モデル", "column": "prog", "lane": "data", "transforms": ["application-data-model"], "ids": ["JROW-*", "JCOL-*"] },
    { "id": "access", "name": "Mapper", "column": "prog", "lane": "data", "transforms": ["application-access"], "ids": ["MAP-*", "JMTH-*"] },
    { "id": "sin", "name": "Service の入力", "column": "prog", "lane": "op", "transforms": ["application-service-inputs"], "ids": ["SINPUT-*"] },
    { "id": "sbind", "name": "Service の Mapper 対応", "column": "prog", "lane": "op", "transforms": ["application-service-bindings"], "ids": ["SPROG-*"] },
    { "id": "sprog", "name": "Service の手順", "column": "prog", "lane": "op", "transforms": ["application-service-programs"], "ids": ["JSERVICE-*"] },
    { "id": "wform", "name": "Form", "column": "prog", "lane": "screen", "transforms": ["application-web-forms"], "ids": ["JFORM-*"] },
    { "id": "wbind", "name": "画面と Service の接続", "column": "prog", "lane": "screen", "transforms": ["application-web-bindings"], "ids": ["JWEB-*"] },
    { "id": "web", "name": "Controller と画面", "column": "prog", "lane": "screen", "transforms": ["application-web"],
      "ids": ["JCONT-*", "WPAGE-*", "JREAD-*", "APP-web"] },
    { "id": "runtime", "name": "状態型と例外", "column": "prog", "lane": "msg", "transforms": ["application-runtime-model"], "ids": ["JERR-*", "JSTATE-*"] },
    { "id": "jtypes", "name": "Java 型の対応", "column": "prog", "lane": "arch", "transforms": ["application-java-types"], "ids": ["APP-java-types"],
      "input": "design/detail/inputs/application/java-types.yaml" },
    { "id": "conf", "name": "アプリ設定", "column": "prog", "lane": "arch", "transforms": ["application-input-gate", "application-configuration"],
      "ids": ["APP-settings"], "input": "design/detail/inputs/application/settings.yaml" },
    { "id": "theme", "name": "画面テーマ", "column": "prog", "lane": "arch", "transforms": ["application-theme-input-gate", "application-theme"],
      "ids": ["APP-theme"], "input": "design/detail/inputs/appearance/theme.yaml" }
  ],
  "notes": [
    "処理設計書は、データ設計と画面設計の上に乗っていません。内容を読むのはメッセージ定義書と状態の判定だけです。テーブルアクセス設計書からは呼び名の付け替え表だけを受け取り、画面の設計書からは何も受け取りません。呼ぶ Mapper の名前は、業務モデルから同じ命名規則で計算し直しています。",
    "アクション定義書が、ほぼ全部の上流です。ほかの設計書は、補正後の業務モデルの中の操作として読みます。",
    "テーブルアクセス設計書の読み出しは、画面定義書を通りません。業務モデルのダッシュボードとビューから直接、検索と件数のメソッドを作っています。",
    "画面定義書（操作）とメッセージ定義書が互いを読みます。画面定義書の候補 → メッセージ定義書 → 画面定義書の確定、の順です。"
  ],
  "footnotes": [
    "画面の URL の付け替え表は一覧・詳細・操作の 3 種をまとめているので、そのうちどれを実際に使うかまでは区別していません。",
    "ソースコードはこの図に入れていません（プログラム設計からレポートで作ります。例外は DDL がテーブル設計書を、CSS が画面のクラスの対応表を、入力エラーの文がメッセージ定義書を直接読む 3 か所です）。"
  ]
}
