    { "id": "theme", "name": "画面テーマ", "column": "prog", "lane": "arch", "transforms": ["application-theme-input-gate", "application-theme"],
      "ids": ["APP-theme"], "input": "design/detail/inputs/appearance/theme.yaml" }
