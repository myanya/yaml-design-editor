#!/usr/bin/env bash
# コミット前の速い検査（30 秒ほど）: 文書の形（docs-lint）・ソースの規則・文書の参照。
# 全テストは GitHub Actions（.github/workflows/test.yml）が push ごとに回す。
# 有効化はクローンごとに 1 回: git config core.hooksPath scripts/git-hooks
set -eu
cd "$(git rev-parse --show-toplevel)"
bash scripts/docs-lint.sh
./gradlew :test --tests '*SourceRulesTest*' --tests '*DocReferencesTest*' -q --console=plain
