{
  "openapi": "3.1.0",
  "info": {
    "title": "YDE 業務 Web",
    "version": "1"
  },
  "paths": {
    "/web-api/session/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 43,
                    "maxLength": 43
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "接続済み",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "機能 OFF は本文のない 404"
          },
          "default": {
            "description": "接続・権限・要求のエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "X-YDE-Login",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "description": "同じ Origin から接続コードを一度だけ交換する。コードは発行から 2 分で失効する。"
      }
    },
    "/web-api/session": {
      "get": {
        "operationId": "session",
        "responses": {
          "200": {
            "description": "接続状態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "機能 OFF は本文のない 404"
          },
          "default": {
            "description": "接続・権限・要求のエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/web-api/session/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "接続を終了"
          },
          "404": {
            "description": "機能 OFF は本文のない 404"
          },
          "default": {
            "description": "接続・権限・要求のエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-YDE-CSRF",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "同じ Origin と CSRF を確認し、サーバの資格情報と Cookie を失効させる。"
      }
    },
    "/web-api/workspace": {
      "get": {
        "operationId": "workspace",
        "responses": {
          "200": {
            "description": "保存済みの概要",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "404": {
            "description": "機能 OFF は本文のない 404"
          },
          "default": {
            "description": "接続・権限・要求のエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientId",
          "clientName",
          "workspaceId",
          "expiresAt",
          "csrfToken"
        ],
        "properties": {
          "clientId": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspaceId",
          "epoch",
          "revision",
          "data"
        ],
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "epoch": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documents",
              "state"
            ],
            "properties": {
              "documents": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "enum": [
                  "saved"
                ],
                "type": "string"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "webSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "yde_web_session",
        "description": "HttpOnly・SameSite=Strict・Path=/web-api の専用 Cookie"
      }
    }
  },
  "security": [
    {
      "webSession": []
    }
  ]
}
